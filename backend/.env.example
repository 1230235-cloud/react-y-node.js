# ---- Entorno ----
NODE_ENV=development
PORT=3001

# Ruta base del backend (relativa al process.cwd())
TRUST_PROXY=0

# ---- MariaDB ----
# Debe coincidir con el usuario creado en database/schema.sql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=lab_app
DB_PASSWORD=CAMBIAR_ESTA_CLAVE
DB_NAME=lab_escolar
DB_CONNECTION_LIMIT=10

# ---- Autenticacion ----
# Genera una con:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# minimo 32 caracteres; el arranque falla si no se cumple.
JWT_SECRET=cambia_esto_por_un_secreto_aleatorio_de_64_caracteres
JWT_EXPIRES_IN=8h
COOKIE_NAME=lab_token
BCRYPT_ROUNDS=10

# ---- Subida de fotos ----
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=2097152

# ---- Limites de peticiones ----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
UPLOAD_RATE_LIMIT_MAX=20